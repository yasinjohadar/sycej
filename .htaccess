# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php83" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# Serve the site from /public without showing it in the URL, for hosts
# (like cPanel) where the project sits directly in the web root.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Old links that include /public/ are redirected to the clean URL.
    RewriteCond %{THE_REQUEST} \s/public/([^\s?]*) [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # Everything else is handled by public/ (and its own .htaccess).
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Never serve dotfiles such as .env, even if rewriting is unavailable.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
